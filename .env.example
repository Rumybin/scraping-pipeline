# Copy to .env and fill in real values locally. Never commit .env — see CLAUDE.md §2 Hard Rule 2.

# Selects the active backend set: local | free | aws. See CLAUDE.md §5.
PIPELINE_BACKEND=local

# Structured log level (e.g. DEBUG, INFO, WARNING). Optional, defaults to INFO.
LOG_LEVEL=

# Honest, contactable User-Agent sent with every fetch (NFR-6). Optional — defaults to a generic
# placeholder; override with your own project URL before running against real sites.
USER_AGENT=

# --- free backend: Cloudflare R2 (S3-compatible object store) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- free backend: Cloudflare D1 (state store) ---
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=

# --- free / aws backend: Discord webhook used by the Notifier ---
DISCORD_WEBHOOK_URL=

# --- aws backend: S3 object store ---
AWS_S3_BUCKET_NAME=
AWS_REGION=

# --- aws backend: DynamoDB state store ---
AWS_DYNAMODB_TABLE=

# --- aws backend: credentials. Normally provided by the ECS task's IAM role;
# only set these for local testing directly against real AWS resources. ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
